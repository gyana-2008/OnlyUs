# BETWEEN — Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# NEVER commit the actual .env file to Git!

# Security & Tokens
SECRET_KEY=between_super_secret_production_key_change_me_in_prod_384917398
JWT_SECRET=between_jwt_secret_production_key_change_me_in_prod_928374912
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database Configuration (SQLite for local, PostgreSQL for cloud/production)
DATABASE_URL=sqlite:///./between.db
# Example PostgreSQL URL for cloud deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/between

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Demo Mode (Allows quick testing with pre-seeded demo accounts in dev)
# Set to false in production to disable all demo routes and demo switcher UI
DEMO_MODE=true

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# News Service Configuration
# Optional: News API key (e.g. newsapi.org) if using external commercial feeds.
# If left empty, Between uses its built-in live RSS feed aggregator + offline editorial fallback dataset.
NEWS_API_KEY=

# CORS Configuration (Comma-separated origins for production frontend)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
